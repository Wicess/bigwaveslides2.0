# ──────────────────────────────────────────────────────────────
# Big Wave Slides — environment variables
# Copy to `.env.local` for local dev and fill in.
# In production, set these in the Vercel project (Settings → Environment Variables).
# NEVER commit real secrets. See DEPLOYMENT.md for the full launch guide.
# ──────────────────────────────────────────────────────────────

# Public site URL (production: https://bigwavesslides.com)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Database — Neon PostgreSQL ────────────────────────────────
# Pooled connection (runtime) and direct connection (migrations).
DATABASE_URL=""           # postgresql://...-pooler.../neondb?sslmode=require
DIRECT_URL=""             # postgresql://... (non-pooled, for migrations)

# ── Cloudflare R2 + CDN ───────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ENDPOINT=""            # https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""          # e.g. https://media.bigwavesslides.com

# ── Authentication — NextAuth + admin/reset signing ───────────
NEXTAUTH_SECRET=""        # generate: openssl rand -base64 32  (REQUIRED in prod)
NEXTAUTH_URL="http://localhost:3000"   # production: https://bigwavesslides.com

# ── Email — Hostinger SMTP ────────────────────────────────────
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="contact@bigwavesslides.com"
SMTP_PASSWORD=""
SMTP_FROM="Big Wave Slides <contact@bigwavesslides.com>"

# ── WhatsApp Cloud API (optional) ─────────────────────────────
WHATSAPP_PHONE_NUMBER=""           # public click-to-chat number, e.g. 15551234567
WHATSAPP_TOKEN=""                  # Meta permanent access token
WHATSAPP_PHONE_NUMBER_ID=""        # Meta phone number ID
WHATSAPP_VERIFY_TOKEN=""           # any random string; matches Meta webhook config

# ── Cron security (abandoned-cart sweep) ──────────────────────
CRON_SECRET=""            # generate: openssl rand -base64 32  (Vercel sends it as Bearer)

# ── AI product search embeddings (optional, future) ───────────
EMBEDDINGS_API_KEY=""

# ── Analytics (optional) ──────────────────────────────────────
NEXT_PUBLIC_GA_ID=""              # G-XXXXXXXXXX
NEXT_PUBLIC_CLARITY_ID=""
NEXT_PUBLIC_AHREFS_KEY="Ny2YCleKHI0SfuTKoVJZiQ"
# Fraction of NON-landing page views stored (the first view of a session is
# always stored). 1 = full click path per visitor; 0.15 = the frugal default.
NEXT_PUBLIC_ANALYTICS_SAMPLE="1"

# ntfy push notifications (admin order alerts). Topic must be long & unguessable.
NTFY_TOPIC=""
# Optional — only for self-hosted ntfy servers:
# NTFY_SERVER="https://ntfy.sh"
# NTFY_TOKEN=""

# Search Console / Bing ownership verification. Leave BLANK until you verify a
# property for THIS domain — a stale token verifies nothing and leaves a meta
# tag claiming ownership from another account. DNS TXT verification is better
# where available: it survives redeploys and domain moves with no code change.
NEXT_PUBLIC_GOOGLE_VERIFICATION=""
NEXT_PUBLIC_BING_VERIFICATION=""
