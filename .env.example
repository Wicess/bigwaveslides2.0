# ──────────────────────────────────────────────────────────────
# Big Wave Slides — environment variables
# Copy to `.env.local` and fill in. NEVER commit real secrets.
# Each block becomes required in the phase noted.
# ──────────────────────────────────────────────────────────────

# Public site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Database — Neon PostgreSQL (Phase 4) ──────────────────────
# Pooled connection (runtime) and direct connection (migrations).
DATABASE_URL=""
DIRECT_URL=""

# ── Cloudflare R2 + CDN (Phase 5) ─────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""          # e.g. https://media.bigwaveslides.com

# ── Authentication — NextAuth (Phase 14) ──────────────────────
NEXTAUTH_SECRET=""        # generate: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"

# ── Email — Hostinger SMTP (Phase 17) ─────────────────────────
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Big Wave Slides <hello@bigwaveslides.com>"

# ── WhatsApp Cloud API (Phase 17) ─────────────────────────────
WHATSAPP_PHONE_NUMBER=""          # public click-to-chat number, e.g. 15551234567
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# ── AI product search embeddings (Phase 9) ────────────────────
EMBEDDINGS_API_KEY=""

# ── Analytics (Phase 17) ──────────────────────────────────────
NEXT_PUBLIC_GA_ID=""              # G-XXXXXXXXXX
NEXT_PUBLIC_CLARITY_ID=""
