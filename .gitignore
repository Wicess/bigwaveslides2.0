# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*

# Next.js
/.next/
/out/
next-env.d.ts

# Production build
/build
/dist

# Environment variables (NEVER commit secrets)
.env
.env*.local
.env.production
.env.development

# Prisma
/prisma/*.db
/prisma/*.db-journal

# Vercel
.vercel

# TypeScript
*.tsbuildinfo

# Testing / coverage
/coverage
/playwright-report
/test-results

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS / Editor
.DS_Store
Thumbs.db
*.swp
.idea
.vscode/*
!.vscode/extensions.json

# Local media scratch (downloaded before upload to R2)
/media-scratch

# Local video/media (upload to Cloudflare R2, never commit)
/images/Videos/
*.mkv
*.mp4
*.mov

# Agent skill tooling (installed via `npx skills`; also live globally in ~/.claude)
.claude/skills/
.agents/
skills-lock.json

# Throwaway debugging scripts (admin-audit.tmp.mjs, login-debug.tmp.mjs, ...)
*.tmp.mjs
VERCEL-ENV.txt

# Downloaded source data for scripts/gen-city-climate.py (~30 MB)
.cache/
